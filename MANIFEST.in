# Explicit public source inventory; update when adding required source/test files.
# Override setuptools defaults so unlisted local files cannot enter an sdist.
global-exclude *
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include MANIFEST.in
include README.md
include SECURITY.md
include docs/JSON_SCHEMA.md
include docs/LAUNCH.md
include docs/README.fr.md
include docs/RELEASE_CHECKSUMS.md
include docs/ROADMAP.md
include docs/STARTER_ISSUES.md
include docs/demo-preview.png
include docs/demo.html
include docs/schema-examples/empty.json
include docs/schema-examples/invalid-kind.json
include docs/schema-examples/nonempty.json
include docs/schema-v1.json
include examples/brief.md
include examples/pytest.xml
include examples/vitest.xml
include pyproject.toml
include scripts/build_demo.py
include scripts/check_json_schema.py
include scripts/check_local_links.py
include scripts/check_sdist.py
include scripts/release_checksums.py
include scripts/smoke_wheel.py
include src/junit2context/__init__.py
include src/junit2context/__main__.py
include src/junit2context/cli.py
include src/junit2context/core.py
include tests/fixtures/pytest-9.1.1/README.md
include tests/fixtures/pytest-9.1.1/normalize_report.py
include tests/fixtures/pytest-9.1.1/report.xml
include tests/fixtures/pytest-9.1.1/sample_tests.py
include tests/test_cli.py
include tests/test_core.py
include tests/test_local_links.py
include tests/test_pytest_fixture.py
include tests/test_release_checksums.py
include tests/test_review.py
include tests/test_sdist.py
include tests/test_wheel_smoke.py
